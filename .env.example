# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/gatekeeper?schema=public"

# JWT Secret Key (Must be a strong, random string in production)
JWT_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"

# FastAPI CNIC & Driving License OCR Microservice URL
FASTAPI_URL="http://localhost:8000"

# Next.js Public App Name
NEXT_PUBLIC_APP_NAME="Gatekeeper Visitor Management System"

# Optional: Default Overstay Threshold (in hours)
OVERSTAY_HOURS="8"

# Optional: Default Initial Admin Account (Used by prisma/seed.js if not overridden)
ADMIN_EMAIL="admin@gatekeeper.local"
ADMIN_PASSWORD="ChangeMeImmediately123!"

# Optional: QR Login Encryption Secret (32+ characters recommended for AES-256)
# Falls back to derived JWT_SECRET if omitted
QR_LOGIN_SECRET="replace-with-a-dedicated-32-char-qr-encryption-secret"

# SMTP Email Configuration (Server-Side Only — Never expose to client)
EMAIL_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@example.com"
SMTP_PASS="replace-with-smtp-password-or-app-password"
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Gatekeeper Security System"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
APP_BASE_URL="http://localhost:3000"
