generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  EMPLOYEE
}

enum EmployeeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum GateType {
  ENTRY
  EXIT
  BOTH
}

enum PersonCategory {
  VISITOR
  VENDOR
  INTERVIEW
  SPECIAL_GUEST
  CONTRACTOR
  DELIVERY
}

enum VisitStatus {
  CHECKED_IN
  CHECKED_OUT
  OVERSTAY
}

enum ParcelSource {
  EXPECTED
  UNEXPECTED
}

enum ParcelStatus {
  EXPECTED
  RECEIVED
  DELIVERED
}

enum VipVisitStatus {
  UPCOMING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  passwordHash     String
  name             String
  role             Role                   @default(OPERATOR)
  active           Boolean                @default(true)
  approvalStatus   EmployeeApprovalStatus @default(APPROVED)
  departmentId     String?
  departmentName   String?
  position         String?
  phoneNumber      String?
  approvedAt       DateTime?
  approvedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?
  operatorNumber   String?                @unique
  qrLoginHash      String?                @unique
  qrLoginEncrypted String?
  qrLoginCreatedAt DateTime?
  qrLoginRevokedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  gateAccess       UserGateAccess[]
  checkIns         Visit[]                @relation("CheckedInBy")
  checkOuts        Visit[]                @relation("CheckedOutBy")
  auditLogs        AuditLog[]
  invitations      GuestInvitation[]      @relation("EmployeeInvitations")

  @@index([role, approvalStatus])
  @@map("users")
}

model Gate {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  type        GateType         @default(BOTH)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userAccess  UserGateAccess[]
  entryVisits Visit[]          @relation("EntryGate")
  exitVisits  Visit[]          @relation("ExitGate")

  @@map("gates")
}

model UserGateAccess {
  id        String   @id @default(cuid())
  userId    String
  gateId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gate      Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gateId])
  @@map("user_gate_access")
}

model Person {
  id                 String         @id @default(cuid())
  category           PersonCategory @default(VISITOR)
  fullName           String
  fatherHusbandName  String?
  cnicNumber         String?        @unique
  dlsNumber          String?        @unique
  gender             String?
  dateOfBirth        String?
  dateOfIssue        String?
  dateOfExpiry       String?
  licensingAuthority String?
  identification     String?
  presentAddress     String?
  permanentAddress   String?
  phoneNumber        String?
  photoUrl           String?
  cnicImageData      String?
  cnicImageMime      String?
  dlsImageData       String?
  dlsImageMime       String?
  company            String?
  belongings         String?
  isVip              Boolean        @default(false)
  isBlacklisted      Boolean        @default(false)
  blacklistReason    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  visits             Visit[]

  @@index([fullName])
  @@index([cnicNumber])
  @@index([dlsNumber])
  @@index([phoneNumber])
  @@index([category])
  @@map("persons")
}

model Visit {
  id             String      @id @default(cuid())
  visitNumber    String      @unique
  passCode       String?     @unique
  personId       String
  person         Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  hostName       String
  department     String
  departmentId   String?
  departmentRef  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  purpose        String?
  visitorCardNo  String?
  vehicleNo      String?
  belongings     String?
  status         VisitStatus @default(CHECKED_IN)
  checkInTime    DateTime    @default(now())
  checkOutTime   DateTime?
  entryGateId    String
  entryGate      Gate        @relation("EntryGate", fields: [entryGateId], references: [id])
  exitGateId     String?
  exitGate       Gate?       @relation("ExitGate", fields: [exitGateId], references: [id])
  checkedInById  String
  checkedInBy    User        @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutById String?
  checkedOutBy   User?       @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([personId])
  @@index([status])
  @@index([checkInTime])
  @@index([visitorCardNo])
  @@index([passCode])
  @@index([hostName])
  @@index([department])
  @@index([departmentId])
  @@map("visits")
}

model Department {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  hodName        String
  whatsappNumber String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  visits         Visit[]

  @@index([active])
  @@map("departments")
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  entityType    String
  entityId      String?
  details       String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([performedById])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model GuestInvitation {
  id                     String           @id @default(cuid())
  employeeId             String
  employee               User             @relation("EmployeeInvitations", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName           String
  departmentId           String?
  departmentName         String
  guestName              String
  guestPhone             String
  guestCnic              String?
  guestPhotoUrl          String?
  alongWith              String?
  visitorCardNo          String?
  normalizedCardKey      String?
  visitDate              String
  expectedArrivalTime    String
  expectedDurationWindow String?
  status                 InvitationStatus @default(PENDING)
  idempotencyKey         String?          @unique
  visitId                String?          @unique
  actualCheckInTime      DateTime?
  actualCheckOutTime     DateTime?
  entryGateId            String?
  entryGateName          String?
  checkedInById          String?
  checkedInByName        String?
  reinvitedFromId        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([employeeId, createdAt])
  @@index([status, visitDate])
  @@index([normalizedCardKey, status])
  @@map("guest_invitations")
}

model AppNotification {
  id              String   @id @default(cuid())
  recipientUserId String?
  recipientRole   String?
  type            String
  title           String
  message         String
  invitationId    String?
  visitId         String?
  parcelId        String?
  vipGuestId      String?
  operatorUserId  String?
  targetUrl       String?
  dedupeKey       String?  @unique
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead, createdAt])
  @@index([recipientRole, createdAt])
  @@map("app_notifications")
}

model Parcel {
  id                  String       @id @default(cuid())
  parcelNumber        String       @unique
  source              ParcelSource @default(EXPECTED)
  status              ParcelStatus @default(EXPECTED)
  employeeId          String?
  ownerName           String
  ownerPhone          String
  departmentId        String?
  departmentName      String
  senderPlatform      String?
  expectedArrivalDate String?
  photoUrl            String?
  receivingGateId     String?
  receivingGateName   String?
  receivedAt          DateTime?
  receivedById        String?
  receivedByName      String?
  deliveryGateId      String?
  deliveryGateName    String?
  deliveredAt         DateTime?
  deliveredById       String?
  deliveredByName     String?
  notes               String?
  idempotencyKey      String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@index([source, status])
  @@index([departmentId])
  @@map("parcels")
}

model VipGuest {
  id                 String         @id @default(cuid())
  vipName            String
  phoneNumber        String
  designation        String
  vehicleNumber      String
  plannedArrivalTime String
  cnicNumber         String?
  photoUrl           String?
  notes              String?
  status             VipVisitStatus @default(UPCOMING)
  active             Boolean        @default(true)
  actualCheckInTime  DateTime?
  checkInGateId      String?
  checkInGateName    String?
  checkedInById      String?
  checkedInByName    String?
  actualCheckOutTime DateTime?
  checkOutGateId     String?
  checkOutGateName   String?
  checkedOutById     String?
  checkedOutByName   String?
  createdById        String?
  createdByName      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([vehicleNumber])
  @@index([vipName])
  @@map("vip_guests")
}

model EmailOutbox {
  id             String    @id @default(cuid())
  eventType      String
  recipientEmail String
  subject        String
  entityId       String
  dedupeKey      String    @unique
  status         String    @default("PENDING")
  smtpMessageId  String?
  errorMessage   String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([entityId, eventType])
  @@index([status])
  @@map("email_outbox")
}

